---
/**
 * PERSONEL PANELİ DÜZENİ (2. faz) — Temel.astro üzerine: bant + noindex + CSP oradan gelir.
 * Kamu düzeni (Genel.astro) kullanılmaz. Dil bağlantıları /panel/ (TR) ve /panel/{dil}/.
 */
import Temel from './Temel.astro';
import { DIL_BILGI, yol, varlik, type Dil } from '../i18n/diller';
import { sozluk } from '../i18n';
import { panelSozluk } from '../i18n/panel';
import { PANEL_DILLERI, panelYolu, appYolu } from '../lib/gezinti';

interface Props { dil: Dil }
const { dil } = Astro.props;
const s = sozluk(dil);
const m = panelSozluk(dil);
const alternatifler = Object.fromEntries(PANEL_DILLERI.map((d) => [DIL_BILGI[d].htmlLang, panelYolu(d)]));
---
<Temel
  htmlLang={DIL_BILGI[dil].htmlLang}
  baslik={`${m.panel.sayfaBaslik} · ${s.genel.siteAdi}`}
  aciklama={m.panel.aciklama}
  bandMetin={s.genel.onizlemeBandi}
  bandAciklama={s.genel.onizlemeAciklama}
  alternatifler={alternatifler}
>
  <header class="border-b border-cizgi bg-white">
    <div class="kap flex flex-wrap items-center justify-between gap-x-4 gap-y-2 py-2.5">
      <a href={yol(dil)} class="flex min-w-0 items-center gap-3 text-dy-metin no-underline hover:text-dy-metin" title={m.ortak.kamuSitesi}>
        <img src={varlik('amblem/diyanet-logotype.svg')} alt={s.genel.amblemAlt.diyanet} width="100" height="36" class="h-8 w-auto shrink-0" />
        <span class="h-8 w-px shrink-0 bg-cizgi" aria-hidden="true"></span>
        <img src={varlik('amblem/bdv-amblem.svg')} alt={s.genel.amblemAlt.bdv} width="34" height="34" class="h-8 w-8 shrink-0" />
        <span class="ui min-w-0 leading-tight">
          <span class="block text-[0.95rem] font-bold">{m.panel.sayfaBaslik}</span>
          <span class="block text-xs font-semibold text-dy-gri-koyu">{s.genel.siteAdi} · {m.panel.ustEtiket}</span>
        </span>
      </a>
      <nav aria-label={m.ortak.dilSecimi}>
        <ul class="flex items-center gap-1">
          {PANEL_DILLERI.map((d) => (
            <li>
              <a href={panelYolu(d)} hreflang={DIL_BILGI[d].htmlLang} lang={DIL_BILGI[d].htmlLang} title={DIL_BILGI[d].ad}
                aria-current={d === dil ? 'true' : undefined} data-panel-dil={d}
                class:list={['ui inline-flex min-h-10 min-w-10 items-center justify-center rounded-full px-2 text-sm font-semibold no-underline',
                  d === dil ? 'bg-dy-koyu text-white hover:text-white' : 'text-dy-metin hover:bg-kagit-2']}
              ><span class="sr-only">{DIL_BILGI[d].ad}</span><span aria-hidden="true">{DIL_BILGI[d].kisa}</span></a>
            </li>
          ))}
          <li class="ml-1 hidden sm:block"><a href={appYolu(dil)} class="ui inline-flex min-h-10 items-center rounded-full border border-cizgi px-3 text-sm font-semibold no-underline">{m.ortak.uygulama}</a></li>
        </ul>
      </nav>
    </div>
  </header>
  <main id="icerik" tabindex="-1" class="outline-none">
    <slot />
  </main>
</Temel>
