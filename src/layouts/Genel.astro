---
/**
 * KAMU SAYFA DÜZENİ (1. faz): Temel + üst bilgi + içerik + alt bilgi.
 * 2. faz: /panel/ ve /app/ bu düzeni DEĞİL, Temel.astro üzerine kurulacak kendi düzenlerini kullanır.
 */
import Temel from './Temel.astro';
import UstBilgi from '../components/UstBilgi.astro';
import Altbilgi from '../components/Altbilgi.astro';
import { DILLER, DIL_BILGI, yol, VARSAYILAN_DIL, type Dil, type SayfaVeyaAna } from '../i18n/diller';
import { sozluk } from '../i18n';

interface Props { dil: Dil; sayfa: SayfaVeyaAna; baslik: string; aciklama: string }
const { dil, sayfa, baslik, aciklama } = Astro.props;
const s = sozluk(dil);

const alternatifler: Record<string, string> = Object.fromEntries(DILLER.map((d) => [DIL_BILGI[d].htmlLang, yol(d, sayfa)]));
alternatifler['x-default'] = yol(VARSAYILAN_DIL, sayfa);
const tamBaslik = sayfa === 'ana' ? `${s.genel.siteAdi} · ${s.genel.kurumlar[1]}` : `${baslik} · ${s.genel.siteAdi}`;
---
<Temel
  htmlLang={DIL_BILGI[dil].htmlLang}
  baslik={tamBaslik}
  aciklama={aciklama}
  bandMetin={s.genel.onizlemeBandi}
  bandAciklama={s.genel.onizlemeAciklama}
  alternatifler={alternatifler}
>
  <a href="#icerik" class="ui sr-only z-50 rounded-full bg-bdv px-4 py-2 font-semibold text-white focus:not-sr-only focus:absolute focus:top-14 focus:left-4">{s.genel.icerigeGec}</a>
  <UstBilgi dil={dil} sayfa={sayfa} />
  <main id="icerik" tabindex="-1" class="outline-none">
    <slot />
  </main>
  <Altbilgi dil={dil} />
</Temel>
