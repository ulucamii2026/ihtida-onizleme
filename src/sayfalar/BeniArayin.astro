---
/**
 * Rıza esaslı rehber haritası ve «Beni arayın» (Öneri 18) — kamu sayfası. Rehberler yalnız rol ve kurumsal kanalla
 * anılır (ad yayımlanmaz); «Beni arayın» formu rıza önce çalışır ve hiçbir değer saklanmaz/gönderilmez.
 * Kamuya açık işaret haritası YOKTUR: haritada yalnız kişinin kendi işareti, yalnız kendi ekranında görünür.
 */
import SayfaBasligi from '../components/SayfaBasligi.astro';
import Ikon from '../components/Ikon.astro';
import BeniArayin from '../islands/BeniArayin';
import { yol, type Dil } from '../i18n/diller';
import { sozluk } from '../i18n';
import { panelSozluk } from '../i18n/panel';
import { ISARET_YERLERI } from '../data/ornek-moduller';

interface Props { dil: Dil }
const { dil } = Astro.props;
const s = sozluk(dil);
const t = s.beniArayin;
const pm = panelSozluk(dil);
const yerler = ISARET_YERLERI.map((kod) => ({ kod, ad: pm.yerler[kod] }));
const rehberIkon = ['kurum', 'kisiler', 'kisi'] as const;
const adimIkon = ['kalkan', 'konum', 'saat'] as const;
---
<SayfaBasligi ustEtiket={t.ustEtiket} baslik={t.sayfaBaslik} giris={t.giris}>
  <div class="mt-6 flex max-w-3xl items-start gap-3 rounded-2xl border-2 border-dashed border-dy-altin bg-dy-altin-acik/70 p-4" data-pilot-notu>
    <Ikon ad="uyari" boyut={22} class="mt-0.5 shrink-0 text-[#5A4F33]" />
    <div>
      <p class="ui text-xs font-bold tracking-[0.08em] text-[#5A4F33] uppercase">{t.pilotEtiket}</p>
      <p class="ui mt-1 font-bold text-dy-metin">{t.pilotNot}</p>
      <p class="mt-1 text-[0.95rem] text-[#5A4F33]">{t.pilotAciklama}</p>
    </div>
  </div>
</SayfaBasligi>

<section class="kap py-12 sm:py-14" aria-labelledby="rehber-baslik">
  <h2 id="rehber-baslik" class="text-[1.6rem] font-bold sm:text-3xl">{t.rehberBaslik}</h2>
  <p class="mt-3 max-w-3xl">{t.rehberAciklama}</p>
  <ul class="mt-8 grid gap-4 md:grid-cols-3" data-rehber-listesi>
    {t.rehberler.map((r, i) => (
      <li class="kart flex flex-col gap-3 p-5">
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-[#E6F0F6] text-bdv"><Ikon ad={rehberIkon[i]} boyut={22} /></span>
        <h3 class="text-lg font-bold">{r.rol}</h3>
        <p>{r.metin}</p>
        <p class="ui mt-auto flex items-center gap-2 rounded-lg bg-kagit-2 px-3 py-2 text-sm font-semibold text-dy-gri-koyu">
          <Ikon ad="kilit" boyut={16} class="shrink-0" />{t.kanal}
        </p>
      </li>
    ))}
  </ul>
  <a class="dugme dugme-ikincil mt-6" href={yol(dil, 'camiler')}><Ikon ad="konum" boyut={18} />{t.camiBul}</a>

  <h2 class="mt-14 text-[1.6rem] font-bold sm:text-3xl">{t.nasilBaslik}</h2>
  <ol class="mt-8 grid gap-4 md:grid-cols-3" data-beni-arayin-adimlar>
    {t.adimlar.map((a, i) => (
      <li class="kart relative flex gap-4 p-5">
        <span class="ui inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-dy-koyu text-lg font-bold text-white" aria-hidden="true">{i + 1}</span>
        <div>
          <h3 class="flex items-center gap-2 text-lg font-bold"><Ikon ad={adimIkon[i]} boyut={20} class="text-dy-koyu" />{a.baslik}</h3>
          <p class="mt-1">{a.metin}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<section class="border-t border-cizgi bg-kagit-2" aria-labelledby="ba-form-baslik">
  <div class="kap py-12 sm:py-14">
    <div class="flex flex-wrap items-center gap-3">
      <h2 id="ba-form-baslik" class="text-[1.6rem] font-bold sm:text-3xl">{t.formBaslik}</h2>
      <span class="rozet rozet-ornek">{s.genel.ornek}</span>
    </div>
    <p class="mt-3 max-w-2xl">{t.formAciklama}</p>
    <div class="mt-8">
      <BeniArayin
        client:visible
        t={t}
        modal={s.modal}
        seciniz={s.basvuru.form.seciniz}
        yasAraliklari={pm.yasAraliklari}
        yerler={yerler}
        cinsiyetler={pm.cinsiyetler}
        kurgusal={pm.ortak.kurgusal}
      />
    </div>
  </div>
</section>
