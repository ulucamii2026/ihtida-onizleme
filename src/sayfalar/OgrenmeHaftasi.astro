---
import SayfaBasligi from '../components/SayfaBasligi.astro';
import IlerlemeBetigi from '../components/IlerlemeBetigi.astro';
import Ikon from '../components/Ikon.astro';
import { yol, type Dil } from '../i18n/diller';
import { sozluk } from '../i18n';
import { HAFTALAR, adimKimligi, adimaGore, guvenliBaglanti, m, videoKimligi } from '../lib/ogrenme-yolu/yol';

interface Props { dil: Dil; id: string }
const { dil, id } = Astro.props;
const k = sozluk(dil).ogrenmeYolu;
const sira = HAFTALAR.findIndex((h) => h.id === id);
const h = HAFTALAR[sira];
const adim = adimaGore(h);
const onceki = HAFTALAR[sira - 1];
const sonraki = HAFTALAR[sira + 1];
const video = videoKimligi(h, dil);
const taslak = h.durum[dil] === 'taslak';
const videoBaslik = `${k.videoBaslik} — ${m(h.baslik, dil)}`;
---
<SayfaBasligi ustEtiket={`${k.haftaEtiketi} ${sira + 1} / ${HAFTALAR.length}`} baslik={m(h.baslik, dil)} giris={m(h.hedef, dil)}>
  <p class="ui mt-4 text-sm font-semibold text-dy-gri-koyu">
    {k.adimaBagli}: <a href={yol(dil, 'ogrenmeYolu', adimKimligi(adim.no))}>{k.adimEtiketi} {adim.no} · {m(adim.baslik, dil)}</a>
  </p>
</SayfaBasligi>

<article class="kap max-w-3xl py-10 sm:py-12">
  <nav aria-label={k.sayfaBaslik} class="ui mb-6 text-sm"><a href={yol(dil, 'ogrenmeYolu')}>← {k.tumHaftalar}</a></nav>

  {taslak && (
    <p class="mb-6 flex items-start gap-2 rounded-xl border border-dy-altin/40 bg-dy-altin-acik/50 p-4 text-[0.95rem]" role="note">
      <span class="rozet rozet-ornek shrink-0">{k.taslak}</span><span>{k.taslakNot}</span>
    </p>
  )}

  <div class="metin-akisi text-[1.075rem]">
    <p>{m(h.metin, dil)}</p>
  </div>

  <aside class="mt-8 flex gap-4 rounded-2xl border border-dy-altin/40 bg-dy-altin-acik/50 p-5 sm:p-6" aria-labelledby="yap-baslik">
    <span class="mt-0.5 shrink-0 text-dy-altin-koyu"><Ikon ad="kitap" boyut={26} /></span>
    <div>
      <h2 id="yap-baslik" class="text-lg font-bold">{k.yap}</h2>
      <p class="mt-1">{m(h.yap, dil)}</p>
    </div>
  </aside>

  {video && (
    <section class="mt-10" aria-labelledby="video-baslik">
      <h2 id="video-baslik" class="text-xl font-bold">{k.videoBaslik}</h2>
      <div class="relative mt-4 aspect-video overflow-hidden rounded-2xl border border-cizgi bg-dy-metin">
        <button type="button" data-video={video} data-baslik={videoBaslik} class="video-dugme absolute inset-0 flex h-full w-full flex-col items-center justify-center gap-3 p-4 text-center text-white">
          <span class="video-oynat inline-flex h-16 w-16 items-center justify-center rounded-full bg-dy-koyu" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </span>
          <span class="ui text-lg font-bold">{k.videoYukle}</span>
          <span class="sr-only">{videoBaslik}</span>
        </button>
      </div>
      <p class="alan-yardim mt-2">{k.videoNot} <a href={`https://www.youtube.com/watch?v=${video}`} rel="noopener noreferrer" target="_blank">{k.videoBaglanti}</a></p>
    </section>
  )}

  <section class="mt-10" aria-labelledby="sorular-baslik">
    <h2 id="sorular-baslik" class="text-xl font-bold">{k.sorular}</h2>
    <p class="alan-yardim">{k.sorularGiris}</p>
    <ol class="mt-4 grid gap-5">
      {h.sorular.map((s) => (
        <li class="kart p-5" data-soru>
          <p class="ui font-bold" id={`s-${s.id}`}>{m(s.soru, dil)}</p>
          <ul class="mt-3 grid gap-2" aria-labelledby={`s-${s.id}`}>
            {s.siklar.map((sik, j) => (
              <li>
                <button type="button" data-sik data-dogru={String(j === s.dogru)} aria-pressed="false"
                  class="sik ui flex min-h-11 w-full items-center gap-2 rounded-xl border-2 border-cizgi bg-white px-4 py-2 text-left text-[0.975rem] font-semibold hover:border-bdv">
                  {m(sik, dil)}
                </button>
              </li>
            ))}
          </ul>
          <p class="ui mt-3 text-sm font-semibold" role="status" aria-live="polite" data-geri data-dogru-metin={k.dogru} data-yanlis-metin={k.yanlis}></p>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-10" aria-labelledby="kaynak-baslik">
    <h2 id="kaynak-baslik" class="text-xl font-bold">{k.kaynaklar}</h2>
    <ul class="mt-3 grid list-disc gap-1.5 pl-5">
      {h.kaynaklar.filter((q) => guvenliBaglanti(q.url)).map((q) => (
        <li><a href={q.url} rel="noopener noreferrer" target="_blank">{m(q.ad, dil)}</a></li>
      ))}
    </ul>
    <p class="alan-yardim mt-2">{k.kaynakNotu}</p>
  </section>

  <section class="kart mt-10 p-5">
    <button type="button" class="dugme dugme-birincil" data-isaretle={h.id} aria-pressed="false">
      <span class="bt-ac inline-flex items-center gap-2"><Ikon ad="onay" boyut={20} />{k.isaretle}</span>
      <span class="bt-kapat inline-flex items-center gap-2" hidden><Ikon ad="onay" boyut={20} />{k.tamamlandi} · {k.isaretKaldir}</span>
    </button>
    <p class="alan-yardim mt-3">{k.cihazNotu}</p>
  </section>

  <nav class="ui mt-10 flex flex-wrap justify-between gap-3" aria-label={k.sayfaBaslik}>
    {onceki ? <a class="dugme dugme-ikincil" href={yol(dil, 'ogrenmeYolu', onceki.id)} rel="prev">← {k.onceki}</a> : <span></span>}
    {sonraki ? <a class="dugme dugme-ikincil" href={yol(dil, 'ogrenmeYolu', sonraki.id)} rel="next">{k.sonraki} →</a> : <span></span>}
  </nav>
</article>
<IlerlemeBetigi />

<style>
  .video-dugme { background: transparent; cursor: pointer; }
  .video-dugme:hover .video-oynat { background: var(--color-dy-koyu-2); }
  .sik[data-sonuc="dogru"] { border-color: #1E6B3A; background: #E8F4EC; }
  .sik[data-sonuc="dogru"]::after { content: "✓"; margin-left: auto; font-weight: 800; color: #1E6B3A; }
  .sik[data-sonuc="yanlis"] { border-color: var(--color-dy-koyu); background: #FBEDEC; }
  .sik[data-sonuc="yanlis"]::after { content: "✗"; margin-left: auto; font-weight: 800; color: var(--color-dy-koyu); }
  [data-geri][data-sonuc="dogru"] { color: #1E6B3A; }
  [data-geri][data-sonuc="yanlis"] { color: var(--color-dy-koyu-2); }
</style>
