---
/**
 * ÖNİZLEME UYARISI — her sayfada zorunlu (kök dil seçici dâhil). 24.09.2026 (Rıdvan): sabit bant yerine
 * açılışta gelen bir pencere; «Anladım» (ya da Esc / arka plan) ile kapanır ve oturum boyunca
 * (sekme açık kaldıkça) bir daha açılmaz. Kapatınca sayfada iz kalmaz.
 *
 * Güvenlik payı: JavaScript kapalıysa aynı metin <noscript> içinde eski sabit bant olarak görünür;
 * önizleme olduğu bilgisi hiçbir durumda kaybolmaz. Pencere ağ isteği yapmaz.
 *
 * Test betiği `dialog[data-onizleme-bandi]` ve `[data-onizleme-noscript]` seçicilerini arar; kaldırmayın.
 * Gerçek platforma geçişte yalnız Temel.astro'daki çağrı kaldırılır.
 */
interface Props { metin: string; aciklama?: string; kapat: string; lang?: string }
const { metin, aciklama, kapat, lang } = Astro.props;
---
<dialog
  id="onizleme-uyarisi"
  data-onizleme-bandi
  lang={lang}
  aria-labelledby="onizleme-uyarisi-baslik"
  aria-describedby={aciklama ? 'onizleme-uyarisi-metin' : undefined}
  class="onizleme-modal m-auto w-[min(92vw,32rem)] rounded-2xl border border-cizgi bg-white p-0 text-dy-metin shadow-2xl backdrop:bg-[rgba(43,43,43,.55)]"
>
  <div class="border-t-4 border-dy-kirmizi p-6 sm:p-7">
    <div class="flex items-start gap-3">
      <span class="mt-0.5 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#FBEDEC] text-dy-koyu" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v5" /><path d="M12 16.5h.01" /></svg>
      </span>
      <div>
        <h2 id="onizleme-uyarisi-baslik" class="ui text-lg font-bold leading-snug sm:text-xl">{metin}</h2>
        {aciklama && <p id="onizleme-uyarisi-metin" class="mt-2">{aciklama}</p>}
      </div>
    </div>
    <div class="mt-6 flex justify-end">
      <button type="button" data-onizleme-kapat class="dugme dugme-birincil min-h-11 min-w-28" autofocus>{kapat}</button>
    </div>
  </div>
</dialog>
<script is:inline>
  (function () {
    var ANAHTAR = 'onizleme-uyarisi-goruldu';
    var d = document.getElementById('onizleme-uyarisi');
    if (!d || typeof d.showModal !== 'function') return;
    var goruldu = false;
    try { goruldu = sessionStorage.getItem(ANAHTAR) === '1'; } catch (e) { /* depolama kapalı: pencere yine açılır */ }
    d.addEventListener('close', function () {
      try { sessionStorage.setItem(ANAHTAR, '1'); } catch (e) { /* yok say */ }
    });
    d.addEventListener('click', function (e) { if (e.target === d) d.close(); });
    var dugme = d.querySelector('[data-onizleme-kapat]');
    if (dugme) dugme.addEventListener('click', function () { d.close(); });
    if (!goruldu) d.showModal();
  })();
</script>
<noscript>
  <div data-onizleme-noscript role="note" lang={lang} class="relative z-50 border-b-2 border-dy-kirmizi bg-dy-koyu text-white">
    <div class="kap flex flex-wrap items-center justify-center gap-x-3 gap-y-0.5 py-2 text-center">
      <strong class="ui text-[0.8125rem] font-bold tracking-[0.06em] sm:text-sm">{metin}</strong>
      {aciklama && <span class="block w-full text-xs leading-snug opacity-95 sm:text-sm md:inline md:w-auto">{aciklama}</span>}
    </div>
  </div>
</noscript>
